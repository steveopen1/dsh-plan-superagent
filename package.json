{
  "name": "dsh-plan-superagent",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Plan board and superagent dispatch in one DSH plugin: one sentence becomes a task tree, each ready task becomes a ticket.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-locale": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.0.1-rc <2",
    "@deepseek-ai/cordis": "^4.0.0-rc",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "dependencies": {
    "dsh-superagent": "github:steveopen1/dsh-superagent#1182d898c7b45041ffafbc41d5776f6cff5a706b",
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "pwsh -File scripts/build.ps1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/bridge-contract-selftest.mjs",
    "build:client": "tsdown"
  }
}
