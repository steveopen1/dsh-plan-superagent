{
  "name": "dsh-plan-superagent",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Plan board and superagent dispatch in one DSH plugin: one sentence becomes a task tree, each ready task becomes a ticket.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc <2",
    "@deepseek-ai/cordis": "^4.0.0-rc",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "dependencies": {
    "dsh-superagent": "github:steveopen1/dsh-superagent#b26693f7d49e855e8980e616545047ff14d9bcf2",
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "pwsh -File scripts/build.ps1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:client": "tsdown"
  }
}
